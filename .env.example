# ENSO Shield example environment. Copy to `.env` and adjust. Never commit `.env`.

# ---- API (services/api) ----
# One of: development | test | production
ENSO_ENV=development
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
ENSO_LOG_LEVEL=INFO
# Comma-separated explicit origins. Wildcards are rejected; production requires https.
ENSO_API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated Host header allowlist. Wildcards are rejected.
# Keep 127.0.0.1: the API container healthcheck calls http://127.0.0.1:8000/health.
ENSO_API_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Leave empty to default (on outside production, off in production). Set true/false to override.
ENSO_API_DOCS_ENABLED=

# ---- Database (PostgreSQL) ----
# Set to '127.0.0.1' for local dev, 'db' inside docker compose, or leave blank to disable DB checks.
# Note: port 5433 is used by default to avoid collision if a native PostgreSQL runs on 5432.
ENSO_DB_HOST=127.0.0.1
ENSO_DB_PORT=5433
ENSO_DB_USER=enso
ENSO_DB_PASSWORD=enso_dev_password
ENSO_DB_NAME=enso_shield
# Optional explicit connection URI override (e.g., for external managed databases)
ENSO_DATABASE_URL=

# ---- Web (apps/web) ----
# Browser-visible API base URL. Inlined at build time by Vite. Must be http(s).
VITE_API_BASE_URL=http://localhost:8000

# ---- Docker Compose host ports (bound to 127.0.0.1) ----
ENSO_API_PORT=8000
ENSO_WEB_PORT=8080
ENSO_DB_PORT=5433
