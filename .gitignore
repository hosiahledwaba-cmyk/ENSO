# ==============================================================================
# ENSO Shield — Production Git Ignore Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/

# ------------------------------------------------------------------------------
# 2. Python Caches, Virtual Environments & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
services/api/.venv/

# Python Tooling, Test & Linter Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# 3. Node.js, Frontend & Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
apps/web/node_modules/
apps/web/dist/
.eslintcache
.vite/
apps/web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 4. OS, Editor & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
.run/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Database Data, Runtime Storage & Logs
# ------------------------------------------------------------------------------
postgres_data/
data/postgres/
*.sqlite3
*.db
*.log
*.pid

# ------------------------------------------------------------------------------
# 6. Temporary Scratch Directories & Transient Archives
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
.temp/
.tempmediaStorage/
.system_generated/
.gemini/
models/.quarantine/
data/experiments/poisoning_isolated/*/

# Large compressed raster archives (downloaded on-demand via ingestion pipeline)
*.tif.gz
data/raw/chirps/*.tif.gz
